{
  "extends": ["//"],
  "tasks": {
    "dev:app": {
      "dependsOn": ["prisma:generate"],
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "CORS_*",
        "LOG_LEVEL",
        "JWT_*",
        "SWAGGER_ENABLED",
        "DATABASE_*",
        "REDIS_*",
        "S3_*"
      ]
    },
    "build:app": { "dependsOn": ["prisma:generate"] },
    "type-check:app": { "dependsOn": ["prisma:generate"] },
    "lint:app": { "dependsOn": ["prisma:generate"] }
  }
}
