generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum FileStatus {
  PENDING
  READY
  DELETING
  DELETED
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  login        String     @unique @db.VarChar(50)
  passwordHash String     @map("password_hash")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  files                        File[]                @relation("FileOwner")
  sessions                     Session[]

  @@index([status])
  @@map("users")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId, lastSeenAt])
  @@index([userId, createdAt])
  @@map("sessions")
}

model File {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId     String     @map("owner_user_id") @db.Uuid
  owner           User       @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  bucket          String     @db.VarChar(255)
  key             String     @db.VarChar(1024)
  originalName    String     @map("original_name") @db.VarChar(255)
  contentType     String     @map("content_type") @db.VarChar(255)
  sizeBytes       Int        @map("size_bytes")
  checksumSha256  String?    @map("checksum_sha256") @db.Char(64)
  status          FileStatus @default(PENDING)
  uploadExpiresAt DateTime?  @map("upload_expires_at")
  readyAt         DateTime?  @map("ready_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  @@unique([bucket, key])
  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, uploadExpiresAt])
  @@map("files")
}
