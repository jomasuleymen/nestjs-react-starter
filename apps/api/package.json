  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "openapi:export": "nest build --path tsconfig.openapi.json && node .generated/nest/export-openapi.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:background": "nest start --entryFile background",
    "start:background:dev": "nest start --entryFile background --watch",
    "start:background:prod": "node dist/background",
    "start:debug": "nest start --debug --watch",
    "postinstall": "prisma generate",
    "lint": "oxlint --type-aware --deny-warnings -c .oxlintrc.json src/ prisma.config.ts",
    "lint:fix": "pnpm run lint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:reset": "prisma migrate reset"
  },
