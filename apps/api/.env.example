# Application Settings
# Runtime environment variables override values from .env.local and .env.
# In production, inject secrets through the deployment environment.
NODE_ENV=development
PORT=3000
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Background runtime (required only for `npm run start:background`)
BACKGROUND_ROLE=worker
BACKGROUND_JOBS=files,contracts

# Auth settings (use independent secrets with at least 32 characters)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Database Settings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=docs-tsl
DATABASE_LOGGING=false

# Cache settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# MinIO settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-password
MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 application settings
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=docs-tsl
S3_REGION=us-east-1
S3_ACCESS_KEY=docs-tsl-app
S3_SECRET_KEY=docs-tsl-app-password
S3_FORCE_PATH_STYLE=true
