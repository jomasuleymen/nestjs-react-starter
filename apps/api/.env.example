# Docker resource namespace
COMPOSE_PROJECT_NAME=starter

# Application Settings
# Runtime environment variables override values from .env.local and .env.
# In production, inject secrets through the deployment environment.
NODE_ENV=development
PORT=3000
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Background runtime (required only for `npm run start:background`)
BACKGROUND_ROLE=worker
BACKGROUND_JOBS=files

# Auth settings (use independent secrets with at least 32 characters)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Database Settings
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=app
DATABASE_LOGGING=false

# Cache settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# RustFS settings
RUSTFS_ACCESS_KEY=storage-admin
RUSTFS_SECRET_KEY=change-me-storage-admin-secret
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# S3 application settings
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=files
S3_REGION=us-east-1
S3_ACCESS_KEY=app-access-key
S3_SECRET_KEY=change-me-in-local-env
S3_FORCE_PATH_STYLE=true
