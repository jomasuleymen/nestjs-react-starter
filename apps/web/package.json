{
  "name": "@starter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm -w run dev --filter=@starter/web",
    "dev:app": "vite",
    "api:generate": "pnpm -w run api:generate",
    "sdk:generate": "openapi-ts",
    "routes:generate": "tsr generate",
    "build": "pnpm -w run build --filter=@starter/web",
    "build:app": "tsc -b --pretty false && vite build",
    "preview": "vite preview",
    "check": "pnpm run lint && pnpm run type-check && pnpm run format:check",
    "type-check": "pnpm -w run type-check --filter=@starter/web",
    "type-check:app": "tsc -b --pretty false",
    "lint": "pnpm -w run lint --filter=@starter/web",
    "lint:app": "pnpm -w exec oxlint apps/web/src apps/web/vite.config.ts apps/web/openapi-ts.config.ts",
    "lint:fix": "pnpm -w run lint --filter=@starter/web -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "1.170.17",
    "antd": "^6.5.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/router-cli": "^1.167.18",
    "@tanstack/router-plugin": "1.168.19",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-compression2": "^2.5.3"
  }
}
