{
  "name": "@starter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "sdk:generate": "openapi-ts",
    "routes:generate": "tsr generate",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --type-aware --deny-warnings -c .oxlintrc.json src/ vite.config.ts openapi-ts.config.ts",
    "lint:fix": "pnpm run lint --fix"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "1.170.46",
    "antd": "^6.7.1",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-compression2": "^2.5.4"
  }
}
