{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["sdk:generate", "routes:generate"],
      "passThroughEnv": ["VITE_*"]
    },
    "build": {
      "dependsOn": ["sdk:generate", "routes:generate"],
      "env": ["VITE_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        ".env.production",
        ".env.production.local"
      ]
    },
    "typecheck": { "dependsOn": ["sdk:generate", "routes:generate"] },
    "lint": { "dependsOn": ["sdk:generate", "routes:generate"] },
    "sdk:generate": {
      "dependsOn": ["@starter/api#openapi:export"],
      "inputs": ["package.json", "openapi-ts.config.ts"],
      "outputs": ["src/api/generated/**"]
    },
    "routes:generate": {
      "inputs": ["package.json", "vite.config.ts", "src/routes/**"],
      "outputs": ["src/routeTree.gen.ts"]
    }
  }
}
