# API origin only. Leave empty for the local same-origin /api proxy.
# Example for production: https://api.example.com
VITE_API_URL=

# Used by Vite only; never exposed to the browser bundle.
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional server-only OpenAPI source used by pnpm run api:generate.
# OPENAPI_INPUT=http://localhost:3000/swagger/yaml
