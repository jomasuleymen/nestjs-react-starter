{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["typescript", "import"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "apps/api/.generated/**",
    "apps/api/src/generated/**",
    "apps/web/src/api/generated/**",
    "apps/web/src/routeTree.gen.ts"
  ],
  "rules": {
    "typescript/no-floating-promises": "error"
  },
  "overrides": [
    {
      "files": ["apps/api/**", "apps/web/*.config.ts"],
      "env": { "node": true }
    },
    {
      "files": ["apps/web/src/**"],
      "env": { "browser": true },
      "plugins": ["typescript", "import", "react", "jsx-a11y"],
      "rules": {
        "typescript/no-explicit-any": "error",
        "typescript/switch-exhaustiveness-check": "error",
        "import/no-cycle": "error",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/label-has-associated-control": "error"
      }
    },
    {
      "files": ["apps/web/src/app/**", "apps/web/src/api/**", "apps/web/src/modules/**", "apps/web/src/shared/**"],
      "rules": {
        "react/only-export-components": ["error", { "allowConstantExport": true }]
      }
    },
    {
      "files": ["apps/web/src/*.{ts,tsx}", "apps/web/src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/*.css", "**/*.scss", "**/*.sass", "**/*.less"] },
              { "group": ["@modules/*/*"], "message": "Import modules through their public exports." }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/*.css", "**/*.scss", "**/*.sass", "**/*.less", "@modules/*/*"] },
              {
                "group": ["@app/**", "!@app/layouts", "!@app/layouts/**"],
                "message": "Routes may import app code only through app/layouts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/modules/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/*.css", "**/*.scss", "**/*.sass", "**/*.less", "@modules/*/*"] },
              { "group": ["@app", "@app/**", "**/app", "**/app/**", "@routes", "@routes/**", "**/routes", "**/routes/**"] }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/*.css", "**/*.scss", "**/*.sass", "**/*.less", "@modules/*/*"] },
              { "group": ["@app", "@app/**", "**/app", "**/app/**", "@modules", "@modules/**", "**/modules", "**/modules/**", "@routes", "@routes/**", "**/routes", "**/routes/**"] }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["**/*.css", "**/*.scss", "**/*.sass", "**/*.less", "@modules/*/*"] },
              { "group": ["@api", "@api/**", "**/api", "**/api/**", "@app", "@app/**", "**/app", "**/app/**", "@modules", "@modules/**", "**/modules", "**/modules/**", "@routes", "@routes/**", "**/routes", "**/routes/**"] }
            ]
          }
        ]
      }
    }
  ]
}
