{
  "name": "starter",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "turbo sdk:generate --filter=@starter/web",
    "db:seed": "turbo db:seed --filter=@starter/api",
    "infra:up": "docker compose --env-file apps/api/.env -f compose.yaml up -d",
    "infra:down": "docker compose --env-file apps/api/.env -f compose.yaml down"
  },
  "devDependencies": {
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.5",
    "turbo": "2.11.10"
  }
}
